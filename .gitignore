# Dependencies
node_modules
.pnp
.pnp.js
package-lock.json
.yarn/install-state.gz

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# A contract:run log before its rename (tooling/contract.ts)
specs/**/evidence/.*.tmp

# Turbo
.turbo

# Storybook (packages/ui)
storybook-static
*storybook.log

# Vercel
.vercel

# Build outputs
.next/
out/
build
dist
*.tsbuildinfo

# Yarn (Berry — keep patches/plugins/releases tracked)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Cursor (local-only; shared agent guidance lives in AGENTS.md)
.cursor/

# Claude Code (local-only; CLAUDE.md pointers are tracked)
# (`.claude/*` rather than `.claude/` so the negation below can take effect —
# git cannot re-include a file whose parent directory is itself excluded.)
.claude/*
# Exception: shared permission/sandbox rules are tracked so every worktree
# inherits them on checkout. Machine-local churn stays in settings.local.json.
!.claude/settings.json
# Path rules, generated subagents and skills are part of the toolkit (docs/index.md).
!.claude/rules/
!.claude/agents/
!.claude/skills/
CLAUDE.local.md

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
