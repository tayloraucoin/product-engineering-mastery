{
  "tier": "starter",
  "specsRoot": "specs",
  "apps": {
    "web": {
      "path": "apps/web",
      "prefix": "WEB",
      "designLayer": "apps/web/docs/design"
    },
    "docs": {
      "path": "apps/docs",
      "prefix": "DOC",
      "designLayer": null
    }
  },
  "toolkitPrefixes": ["PEM", "PJ"],
  "verify": {
    "full": "yarn verify",
    "fast": "yarn verify:fast"
  },
  "migrationsDir": "packages/db/migrations",
  "branchPattern": "agent/{id}",
  "protectedBranch": "main",
  "reviewers": [
    {
      "glob": "**/migrations/**",
      "role": "mason",
      "why": "One-way door: an applied migration is immutable.",
      "status": "draft"
    },
    {
      "glob": "**/schema/**",
      "role": "mason",
      "why": "One-way door: the data model's shape.",
      "status": "draft"
    },
    {
      "glob": "**/*.sql",
      "role": "mason",
      "why": "One-way door: schema and data changes written as SQL.",
      "status": "draft"
    },
    {
      "glob": "packages/config/eslint/boundaries.js",
      "role": "mason",
      "why": "One-way door: the package boundary graph.",
      "status": "draft"
    },
    {
      "glob": "packages/*/package.json",
      "role": "mason",
      "why": "One-way door: a package's exports are its public API shape.",
      "status": "draft"
    },
    {
      "glob": "apps/*/app/api/**",
      "role": "mason",
      "why": "One-way door: public API shape.",
      "status": "draft"
    },
    {
      "glob": "**/billing/**",
      "role": "mason",
      "why": "One-way door: billing.",
      "status": "draft"
    },
    {
      "glob": "**/auth/**",
      "role": "mason",
      "why": "One-way door: authorization topology.",
      "status": "draft"
    },
    {
      "glob": "**/rls.ts",
      "role": "mason",
      "why": "One-way door: the bridge from a request's identity to row-level security.",
      "status": "draft"
    },
    {
      "glob": "**/policies.ts",
      "role": "mason",
      "why": "One-way door: the policy factories every table's row-level security is built from.",
      "status": "draft"
    },
    {
      "glob": "**/auth/**",
      "role": "warden",
      "why": "Authentication and authorization flows, sessions and recovery.",
      "status": "draft"
    },
    {
      "glob": "**/proxy.ts",
      "role": "warden",
      "why": "The request gate every route passes through.",
      "status": "draft"
    },
    {
      "glob": "**/env.ts",
      "role": "warden",
      "why": "The environment seam, where secrets enter.",
      "status": "draft"
    },
    {
      "glob": "**/policies/**",
      "role": "warden",
      "why": "Deny-by-default access policies in the data layer.",
      "status": "draft"
    },
    {
      "glob": "**/rls.ts",
      "role": "warden",
      "why": "Whose identity and role each user-scoped query runs as.",
      "status": "draft"
    },
    {
      "glob": "**/policies.ts",
      "role": "warden",
      "why": "Deny-by-default access policies in the data layer, as one file.",
      "status": "draft"
    },
    {
      "glob": "**/schema/**",
      "role": "warden",
      "why": "Personal data: what is stored, and at what fidelity.",
      "status": "draft"
    },
    {
      "glob": "**/webhooks/**",
      "role": "warden",
      "why": "Third-party callbacks that must be verified.",
      "status": "draft"
    },
    {
      "glob": "**/billing/**",
      "role": "warden",
      "why": "Payment credentials stay with the processor.",
      "status": "draft"
    },
    {
      "glob": ".claude/settings.json",
      "role": "warden",
      "why": "Agent permissions and the sandbox.",
      "status": "draft"
    },
    {
      "glob": "tooling/hooks/**",
      "role": "warden",
      "why": "The guards that enforce agent permissions.",
      "status": "draft"
    },
    {
      "glob": "apps/*/app/**/*.tsx",
      "role": "assay",
      "why": "Rendered UI is scored against the canon rubric.",
      "status": "draft"
    },
    {
      "glob": "packages/ui/**",
      "role": "assay",
      "why": "Shared components render on every surface.",
      "status": "draft"
    },
    {
      "glob": "apps/*/app/**/page.tsx",
      "role": "threshold",
      "why": "A surface: keyboard, focus and screen-reader paths.",
      "status": "draft"
    },
    {
      "glob": "packages/ui/src/**",
      "role": "threshold",
      "why": "An interactive component: its accessible name, roles and states.",
      "status": "draft"
    },
    {
      "glob": "**/legal/**",
      "role": "chancery",
      "why": "Terms, privacy and consent text.",
      "status": "draft"
    },
    {
      "glob": "**/consent/**",
      "role": "chancery",
      "why": "Consent capture and its wording.",
      "status": "draft"
    },
    {
      "glob": "**/billing/**",
      "role": "chancery",
      "why": "Billing copy and what it promises.",
      "status": "draft"
    },
    {
      "imports": ["stripe", "@stripe/*"],
      "role": "mason",
      "why": "One-way door: billing, wherever the Stripe SDK is called.",
      "status": "draft"
    },
    {
      "imports": ["stripe", "@stripe/*"],
      "role": "warden",
      "why": "Payment credentials stay with the processor, wherever the Stripe SDK is called.",
      "status": "draft"
    },
    {
      "imports": ["stripe", "@stripe/*"],
      "role": "chancery",
      "why": "Billing copy and what it promises, wherever the Stripe SDK is called.",
      "status": "draft"
    },
    {
      "imports": ["@supabase/*", "next-auth", "@clerk/*", "better-auth"],
      "role": "mason",
      "why": "One-way door: authorization topology, wherever an auth SDK is called.",
      "status": "draft"
    },
    {
      "imports": ["@supabase/*", "next-auth", "@clerk/*", "better-auth"],
      "role": "warden",
      "why": "Sessions, identity and access, wherever an auth SDK is called.",
      "status": "draft"
    },
    {
      "imports": ["resend"],
      "role": "warden",
      "why": "Personal data: who is emailed and what the message holds.",
      "status": "draft"
    }
  ],
  "stack": {
    "config": {
      "files": ["packages/config"],
      "env": [],
      "dependencies": ["@pem/config"],
      "boundaries": ["config"],
      "locked": true,
      "runbook": null
    },
    "constants": {
      "files": ["packages/constants"],
      "env": [],
      "dependencies": ["@pem/constants"],
      "boundaries": ["constants"],
      "locked": true,
      "runbook": null
    },
    "env": {
      "files": ["packages/env", "apps/web/env.ts", ".env.example"],
      "env": [
        "DATABASE_ENVIRONMENT",
        "VERCEL_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "EXAMPLE_API_KEY"
      ],
      "dependencies": ["@pem/env", "@t3-oss/env-nextjs", "zod"],
      "boundaries": ["env"],
      "locked": true,
      "runbook": null
    },
    "brand": {
      "files": [
        "packages/brand",
        "apps/web/app/manifest.ts",
        "apps/web/app/opengraph-image.tsx"
      ],
      "env": [],
      "dependencies": ["@pem/brand"],
      "boundaries": ["brand"],
      "locked": true,
      "runbook": null
    },
    "observability": {
      "files": ["packages/observability"],
      "env": [],
      "dependencies": ["@pem/observability"],
      "boundaries": ["observability"],
      "locked": true,
      "runbook": null
    },
    "ui": {
      "files": ["packages/ui"],
      "env": [],
      "dependencies": [
        "@pem/ui",
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "@base-ui/react",
        "lucide-react",
        "tw-animate-css",
        "shadcn",
        "input-otp",
        "react-resizable-panels",
        "react-day-picker",
        "date-fns",
        "embla-carousel-react",
        "recharts",
        "react-is",
        "@shadcn/react",
        "cmdk",
        "@tanstack/react-table"
      ],
      "boundaries": ["ui"],
      "locked": true,
      "runbook": null
    },
    "catalog": {
      "files": [
        "packages/catalog",
        "tooling/check-catalog.ts",
        "tooling/check-catalog.test.ts"
      ],
      "env": [],
      "dependencies": ["@pem/catalog"],
      "boundaries": ["catalog"],
      "locked": false,
      "runbook": "docs/runbooks/remove/catalog.md"
    },
    "validators": {
      "files": ["packages/validators"],
      "env": [],
      "dependencies": ["@pem/validators"],
      "boundaries": ["validators"],
      "locked": true,
      "runbook": null
    },
    "db": {
      "files": ["packages/db"],
      "env": ["DATABASE_URL", "DATABASE_MIGRATION_URL"],
      "dependencies": [
        "@pem/db",
        "drizzle-orm",
        "drizzle-kit",
        "postgres",
        "supabase"
      ],
      "boundaries": ["db"],
      "locked": false,
      "runbook": "docs/runbooks/remove/supabase-database.md"
    },
    "auth": {
      "files": [
        "packages/auth",
        "apps/web/proxy.ts",
        "apps/web/lib/supabase",
        "apps/web/app/auth"
      ],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY"
      ],
      "dependencies": ["@pem/auth", "@supabase/ssr", "@supabase/supabase-js"],
      "boundaries": ["auth"],
      "locked": false,
      "runbook": "docs/runbooks/remove/supabase-auth.md"
    },
    "email": {
      "files": ["packages/email", "apps/web/lib/email.ts"],
      "env": ["RESEND_API_KEY", "EMAIL_FROM"],
      "dependencies": ["@pem/email", "resend"],
      "boundaries": ["email"],
      "locked": true,
      "runbook": null
    },
    "ai": {
      "files": ["packages/ai", "apps/web/app/api/ai"],
      "env": ["ANTHROPIC_API_KEY"],
      "dependencies": [
        "@pem/ai",
        "ai",
        "@ai-sdk/anthropic",
        "@ai-sdk/provider"
      ],
      "boundaries": ["ai", "web-ai-route"],
      "locked": false,
      "runbook": "docs/runbooks/remove/ai.md"
    },
    "services": {
      "files": ["packages/services"],
      "env": [],
      "dependencies": ["@pem/services"],
      "boundaries": ["services"],
      "locked": true,
      "runbook": null
    },
    "api": {
      "files": ["packages/api", "apps/web/app/api/trpc", "apps/web/lib/trpc"],
      "env": [],
      "dependencies": [
        "@pem/api",
        "@trpc/server",
        "@trpc/client",
        "@trpc/tanstack-react-query",
        "@tanstack/react-query",
        "superjson"
      ],
      "boundaries": ["api"],
      "locked": false,
      "runbook": "docs/runbooks/remove/api.md"
    },
    "error-monitoring": {
      "files": [
        "apps/web/instrumentation.ts",
        "apps/web/instrumentation-client.ts",
        "apps/web/sentry.server.config.ts",
        "apps/web/sentry.edge.config.ts",
        "apps/web/lib/error-reporting"
      ],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VERCEL_GIT_COMMIT_SHA",
        "NEXT_RUNTIME"
      ],
      "dependencies": ["@sentry/nextjs"],
      "boundaries": ["@sentry/*"],
      "locked": false,
      "runbook": "docs/runbooks/remove/error-monitoring.md"
    },
    "billing": {
      "files": [
        "apps/web/app/api/webhooks/stripe",
        "apps/web/lib/billing",
        "packages/db/src/schema/billing",
        "packages/db/src/billing",
        "packages/db/test/stripe-event-ledger.test.ts",
        "packages/services/src/billing",
        "packages/validators/src/billing"
      ],
      "env": ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "STRIPE_PRICE_ID"],
      "dependencies": ["stripe"],
      "boundaries": ["stripe"],
      "locked": false,
      "runbook": "docs/runbooks/remove/billing.md"
    },
    "experimental-sandbox": {
      "files": [
        "apps/web/app/experimental",
        "apps/web/app/admin",
        "apps/web/lib/sandbox",
        "packages/db/src/schema/sandbox",
        "packages/db/src/sandbox",
        "packages/db/test/sandbox"
      ],
      "env": ["SANDBOX_SECRET"],
      "dependencies": [],
      "boundaries": ["web-sandbox"],
      "locked": false,
      "runbook": "docs/runbooks/remove/experimental-sandbox.md"
    }
  }
}
