{
  "name": "product-engineering-mastery",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:boundaries": "eslint . --max-warnings 0",
    "check-types": "turbo run check-types",
    "check-types:tooling": "tsc -p tooling",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mjs,css}\"",
    "verify": "yarn format:check && yarn lint:docs && yarn check-settings && yarn test:hooks && yarn check-refs && yarn check-stack && yarn check-migrations && yarn check-specs && yarn check-test-weakening && yarn contrast-audit && yarn check-ui-layout && yarn test:tooling && yarn test && yarn budget && yarn gen:agents --check && yarn directory-map --check && yarn lint && yarn lint:boundaries && yarn check-types && yarn check-types:tooling && yarn check-client-bundle && yarn build",
    "verify:fast": "node tooling/verify-fast.ts",
    "web:dev": "turbo run dev --filter=web",
    "web:dev:local": "node tooling/print-local-urls.ts 3000 && turbo run dev --filter=web -- --hostname 0.0.0.0",
    "web:build": "turbo run build --filter=web",
    "docs:dev": "turbo run dev --filter=docs",
    "docs:build": "turbo run build --filter=docs",
    "lint:docs": "node tooling/lint-frontmatter.ts",
    "budget": "node tooling/budget.ts",
    "gen:agents": "node tooling/gen-agents.ts",
    "directory-map": "node tooling/directory-map.ts",
    "check-settings": "node tooling/check-settings.ts",
    "doctor": "node tooling/doctor.ts",
    "test:hooks": "node tooling/test-hooks.ts",
    "check-specs": "node tooling/check-specs.ts",
    "check-test-weakening": "node tooling/check-test-weakening.ts",
    "test:tooling": "node --test \"tooling/**/*.test.ts\"",
    "test": "turbo run test --log-prefix=none",
    "spec:init": "node tooling/spec-init.ts",
    "contract:init": "node tooling/contract.ts init",
    "contract:run": "node tooling/contract.ts run",
    "contract:record": "node tooling/contract.ts record",
    "contract:add": "node tooling/contract.ts add",
    "contract:tier": "node tooling/contract.ts tier",
    "review:run": "node tooling/review-run.ts",
    "status": "node tooling/status.ts",
    "truth:promote": "node tooling/truth-promote.ts",
    "hooks:install": "node tooling/hooks-install.ts",
    "check-refs": "node tooling/check-refs.ts",
    "check-stack": "node tooling/check-stack.ts",
    "check-client-bundle": "node tooling/check-client-bundle.ts",
    "contrast-audit": "node tooling/contrast-audit.ts",
    "check-ui-layout": "node tooling/check-ui-layout.ts",
    "check-migrations": "yarn workspace @pem/db check-migrations",
    "test:db": "yarn workspace @pem/db test:db",
    "db:local": "yarn workspace @pem/db db:local",
    "db:local:full": "yarn workspace @pem/db db:local:full",
    "db:stop": "yarn workspace @pem/db db:stop",
    "db:generate": "yarn workspace @pem/db db:generate",
    "db:migrate": "yarn workspace @pem/db db:migrate",
    "db:setup": "yarn workspace @pem/db db:setup",
    "db:seed-users": "yarn workspace @pem/db db:seed-users"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@pem/config": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.11.6",
    "typescript": "5.9.2",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
