{
  "name": "product-engineering-mastery",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:boundaries": "eslint . --max-warnings 0",
    "check-types": "turbo run check-types",
    "check-types:tooling": "tsc -p tooling",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mjs,css}\"",
    "verify": "yarn format:check && yarn lint:docs && yarn check-settings && yarn test:hooks && yarn check-refs && yarn check-specs && yarn check-test-weakening && yarn test:tooling && yarn budget && yarn gen:agents --check && yarn directory-map --check && yarn lint && yarn lint:boundaries && yarn check-types && yarn check-types:tooling && yarn build",
    "verify:fast": "node tooling/verify-fast.ts",
    "web:dev": "turbo run dev --filter=web",
    "web:build": "turbo run build --filter=web",
    "docs:dev": "turbo run dev --filter=docs",
    "docs:build": "turbo run build --filter=docs",
    "lint:docs": "node tooling/lint-frontmatter.ts",
    "budget": "node tooling/budget.ts",
    "gen:agents": "node tooling/gen-agents.ts",
    "directory-map": "node tooling/directory-map.ts",
    "check-settings": "node tooling/check-settings.ts",
    "doctor": "node tooling/doctor.ts",
    "test:hooks": "node tooling/test-hooks.ts",
    "check-specs": "node tooling/check-specs.ts",
    "check-test-weakening": "node tooling/check-test-weakening.ts",
    "test:tooling": "node --test \"tooling/**/*.test.ts\"",
    "test": "turbo run test",
    "spec:init": "node tooling/spec-init.ts",
    "contract:init": "node tooling/contract.ts init",
    "contract:run": "node tooling/contract.ts run",
    "contract:record": "node tooling/contract.ts record",
    "contract:add": "node tooling/contract.ts add",
    "review:run": "node tooling/review-run.ts",
    "status": "node tooling/status.ts",
    "truth:promote": "node tooling/truth-promote.ts",
    "hooks:install": "node tooling/hooks-install.ts",
    "check-refs": "node tooling/check-refs.ts"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@pem/config": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.11.6",
    "typescript": "5.9.2",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
