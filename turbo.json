{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["**/.env.*local", "**/.env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_ENVIRONMENT",
    "VERCEL_ENV",
    "EXAMPLE_API_KEY",
    "EXAMPLE_API_KEY_LOCAL",
    "EXAMPLE_API_KEY_STAGING",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SITE_URL_LOCAL",
    "NEXT_PUBLIC_SITE_URL_STAGING",
    "DATABASE_URL",
    "DATABASE_URL_LOCAL",
    "DATABASE_URL_STAGING",
    "DATABASE_MIGRATION_URL",
    "DATABASE_MIGRATION_URL_LOCAL",
    "DATABASE_MIGRATION_URL_STAGING",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_URL_LOCAL",
    "NEXT_PUBLIC_SUPABASE_URL_STAGING",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_LOCAL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_STAGING",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_SERVICE_ROLE_KEY_LOCAL",
    "SUPABASE_SERVICE_ROLE_KEY_STAGING",
    "RESEND_API_KEY",
    "RESEND_API_KEY_LOCAL",
    "RESEND_API_KEY_STAGING",
    "EMAIL_FROM",
    "EMAIL_FROM_LOCAL",
    "EMAIL_FROM_STAGING"
  ],
  "globalPassThroughEnv": ["TMPDIR"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    }
  }
}
