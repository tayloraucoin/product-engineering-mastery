{
  "name": "@pem/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./models": {
      "types": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "record": "node --env-file-if-exists=.env.local scripts/record.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/provider": "4.0.18",
    "@pem/env": "workspace:*",
    "@pem/observability": "workspace:*",
    "ai": "7.0.116",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pem/config": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
