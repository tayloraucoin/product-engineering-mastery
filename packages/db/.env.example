# The @pem/db scripts' variables: db:local, db:local:full, db:local:reset,
# db:migrate, db:setup, db:seed-users and test:db. Copy to packages/db/.env.local
# (gitignored): each script runs from this folder and loads only that file, not
# the root one. Tier grammar (D-STK-3): _LOCAL, _STAGING, unsuffixed for
# production. The root .env.example holds the same names for the apps.

# Which tier the scripts act on: local | staging | production. This repo runs
# no local database by default, so this is staging; unset is refused, and
# docs/runbooks/add/docker-local-database.md adds a local one (set local then).
DATABASE_ENVIRONMENT=staging

# Runtime URL: the transaction pooler (port 6543) on a hosted tier. The _LOCAL
# value is read on the local tier only; there, unset means the database
# yarn db:local starts (the synthetic value below).
DATABASE_URL_LOCAL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_STAGING=
DATABASE_URL=

# Migration URL: the session pooler (port 5432) on a hosted tier, used by
# db:migrate and db:setup. Without it a hosted tier cannot be migrated.
DATABASE_MIGRATION_URL_LOCAL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_MIGRATION_URL_STAGING=
DATABASE_MIGRATION_URL=

# Supabase Auth (D-STK-6). The _LOCAL values select the local mode; there is no
# mode variable.
#   Mode A, the default (yarn db:local): the staging project's URL. db:local only
#   warns when it points at this machine; db:seed-users refuses it, since staging
#   users arrive through the local auth mirror when they sign in.
#   Mode B (yarn db:local:full): http://127.0.0.1:54321 and the service-role key
#   `yarn workspace @pem/db supabase status` prints. db:seed-users needs both.
NEXT_PUBLIC_SUPABASE_URL_LOCAL=
SUPABASE_SERVICE_ROLE_KEY_LOCAL=
