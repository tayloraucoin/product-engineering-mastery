{
  "name": "@pem/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./rls": {
      "types": "./src/rls.ts",
      "default": "./src/rls.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./policies": {
      "types": "./src/policies.ts",
      "default": "./src/policies.ts"
    },
    "./connection": {
      "types": "./src/connection.ts",
      "default": "./src/connection.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:db": "node --env-file-if-exists=.env.local --test \"test/**/*.test.ts\"",
    "check-migrations": "node scripts/check-migrations.ts",
    "db:local": "node scripts/local.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup.ts"
  },
  "dependencies": {
    "@pem/env": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@pem/config": "workspace:*",
    "@types/node": "^22",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
