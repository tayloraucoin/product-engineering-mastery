{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "SENTRY_CLI_NO_TELEMETRY=1 next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"e2e/**/*.test.ts\"",
    "e2e": "playwright test --project=e2e",
    "capture": "node e2e/run-capture.ts"
  },
  "dependencies": {
    "@pem/ai": "workspace:*",
    "@pem/api": "workspace:*",
    "@pem/auth": "workspace:*",
    "@pem/brand": "workspace:*",
    "@pem/db": "workspace:*",
    "@pem/email": "workspace:*",
    "@pem/env": "workspace:*",
    "@pem/observability": "workspace:*",
    "@pem/services": "workspace:*",
    "@pem/ui": "workspace:*",
    "@sentry/nextjs": "11.0.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pem/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "tailwindcss": "^4",
    "typescript": "5.9.2"
  }
}
